<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!-- SQL Server – new DFM_BPM database -->
    <add name="DFM_BPMConnection"
         connectionString="Server=LAPTOP-9TLOE1BO;Database=DFM_BPM;Trusted_Connection=True;Connection Timeout=30;"
         providerName="System.Data.SqlClient" />
    <!-- Oracle BPM (DIB UAT) – source of truth for masters and BPM data -->
    <add name="OracleConnection"
         connectionString="Data Source=(DESCRIPTION=(ADDRESS_LIST=(ADDRESS=(PROTOCOL=TCP)(HOST=exaccnonprodcl04-scan.dibuat.ae)(PORT=1628)))(CONNECT_DATA=(SERVER=DEDICATED)(SERVICE_NAME=DMSUAT.dibuat.ae)));User Id=HARICT1735;Password=Admin#5466;"
         providerName="Oracle.ManagedDataAccess.Client" />
  </connectionStrings>

  <appSettings>
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
    <add key="AppName" value="BPM Financial Tracker" />
    <add key="VendorName" value="Dubai Islamic Bank" />
    <!-- Environment: Dev | UAT | Prod -->
    <add key="AppEnvironment" value="Dev" />
    <add key="DevUser" value="devadmin" />
    <add key="DevRole" value="Admin" />
    <!-- JIRA integration -->
    <add key="JiraBaseUrl" value="https://agile.dib.ae/planner" />
    <add key="JiraEmail" value="" />
    <add key="JiraApiToken" value="" />
    <add key="JiraProjectKey" value="DMGT" />
    <!-- Session -->
    <add key="SessionTimeoutMinutes" value="60" />
    <!-- Upload folder (relative to application root or absolute) -->
    <add key="UploadFolder" value="~/Uploads" />
    <!-- Gemini AI key (optional) -->
    <add key="GeminiApiKey" value="" />
  </appSettings>

  <system.web>
    <compilation debug="true" targetFramework="4.5" />
    <httpRuntime targetFramework="4.5" maxRequestLength="20480" requestValidationMode="2.0" />
    <globalization requestEncoding="utf-8" responseEncoding="utf-8" fileEncoding="utf-8" culture="en-US" uiCulture="en-US" />
    <pages validateRequest="false" enableEventValidation="false" viewStateEncryptionMode="Never" />

    <!-- Authentication managed via AppEnvironment flag (Dev=bypass, UAT/Prod=Windows IIS) -->
    <authentication mode="None" />

    <sessionState mode="InProc" timeout="60" />
    <customErrors mode="RemoteOnly" defaultRedirect="~/Default.aspx" />
    <machineKey validationKey="AutoGenerate,IsolateApps"
                decryptionKey="AutoGenerate,IsolateApps"
                validation="SHA1"
                decryption="Auto" />
  </system.web>

  <!-- Public paths still need Content/Scripts -->
  <location path="Content">
    <system.web><authorization><allow users="*" /></authorization></system.web>
  </location>
  <location path="Scripts">
    <system.web><authorization><allow users="*" /></authorization></system.web>
  </location>
  <location path="Assets">
    <system.web><authorization><allow users="*" /></authorization></system.web>
  </location>
  <location path="fonts">
    <system.web><authorization><allow users="*" /></authorization></system.web>
  </location>

  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <modules runAllManagedModulesForAllRequests="false" />
    <staticContent>
      <remove fileExtension=".woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff"  mimeType="application/font-woff" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>
  </system.webServer>
</configuration>
