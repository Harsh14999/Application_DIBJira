<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="DFM_BPM" connectionString="Server=LAPTOP-9TLOE1BO;Database=DFM_BPM;Trusted_Connection=True;Connection Timeout=30;" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <!-- JIRA settings -->
    <add key="JiraBaseUrl"      value="https://agile.dib.ae/planner" />
    <add key="JiraUser"         value="" />
    <add key="JiraPassword"     value="" />
    <add key="Projects"         value="DMGT,DIBITP" />
    <add key="BatchSize"        value="500" />
    <add key="MinBatchSize"     value="50" />
    <add key="HttpTimeoutSeconds" value="300" />
    <add key="MaxFetchAttempts" value="3" />
    <!-- Optional: specify custom JIRA fields to pull (comma-sep field keys) -->
    <add key="JiraFields"       value="" />
    <!-- Output CSV path -->
    <add key="OutputCsvPath"    value="JIRADashboard.csv" />
    <!-- Log folder (relative or absolute) -->
    <add key="LogFolder"        value="logs" />
  </appSettings>
</configuration>
